<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/MM.Screen"
    android:background="@drawable/bg_screen_accent"
    tools:context=".ui.GameOverFragment">

    <TextView
        android:id="@+id/text_title"
        style="@style/MM.Text.BorderLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/content_margin"
        android:text="@string/over_label"
        android:textColor="@color/accent"
        app:layout_constraintBottom_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/text_headline"
        style="@style/MM.Text.Title.Inverse"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/content_margin"
        android:layout_marginTop="48dp"
        android:text="@string/over_headline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide_half"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <TextView
        android:id="@+id/label_depth"
        style="@style/MM.Text.Dim"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="@string/label_depth"
        app:layout_constraintStart_toStartOf="@id/text_headline"
        app:layout_constraintTop_toBottomOf="@id/text_headline" />

    <TextView
        android:id="@+id/text_levels_passed"
        style="@style/MM.Text.Value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/value_placeholder"
        app:layout_constraintStart_toStartOf="@id/label_depth"
        app:layout_constraintTop_toBottomOf="@id/label_depth" />

    <TextView
        android:id="@+id/label_best"
        style="@style/MM.Text.Dim"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_best"
        app:layout_constraintStart_toStartOf="@id/guide_half"
        app:layout_constraintTop_toTopOf="@id/label_depth" />

    <TextView
        android:id="@+id/text_best_score"
        style="@style/MM.Text.Value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/value_placeholder"
        android:textColor="@color/accent"
        app:layout_constraintStart_toStartOf="@id/label_best"
        app:layout_constraintTop_toBottomOf="@id/label_best" />

    <TextView
        android:id="@+id/text_new_best"
        style="@style/MM.Text.Title.Inverse.Accent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/over_new_best"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/guide_half"
        app:layout_constraintTop_toBottomOf="@id/text_best_score"
        tools:visibility="visible" />

    <Button
        android:id="@+id/btn_retry"
        style="@style/MM.Item.Primary"
        android:text="@string/action_retry"
        app:layout_constraintBottom_toTopOf="@id/btn_stats"
        app:layout_constraintStart_toStartOf="@id/text_headline" />

    <Button
        android:id="@+id/btn_stats"
        style="@style/MM.Item"
        android:text="@string/action_stats"
        app:layout_constraintBottom_toTopOf="@id/btn_menu"
        app:layout_constraintStart_toStartOf="@id/text_headline" />

    <Button
        android:id="@+id/btn_menu"
        style="@style/MM.Item"
        android:layout_marginBottom="32dp"
        android:text="@string/action_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/text_headline" />

</androidx.constraintlayout.widget.ConstraintLayout>
