<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/MM.Screen"
    tools:context=".ui.StatsFragment">

    <TextView
        android:id="@+id/text_title"
        style="@style/MM.Text.BorderLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/content_margin"
        android:text="@string/stats_label"
        app:layout_constraintBottom_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/text_headline"
        style="@style/MM.Text.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/content_margin"
        android:layout_marginTop="48dp"
        android:text="@string/stats_headline"
        android:textSize="32sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/col_date"
        style="@style/MM.Text.Dim"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/content_margin"
        android:layout_marginTop="32dp"
        android:text="@string/col_date"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_headline" />

    <TextView
        android:id="@+id/col_runs"
        style="@style/MM.Text.Dim"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/content_margin"
        android:text="@string/col_runs"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/col_date" />

    <TextView
        android:id="@+id/col_best"
        style="@style/MM.Text.Dim"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:text="@string/col_best"
        app:layout_constraintEnd_toStartOf="@id/col_runs"
        app:layout_constraintTop_toTopOf="@id/col_date" />

    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="@dimen/frame_stroke"
        android:layout_marginStart="@dimen/content_margin"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="@dimen/content_margin"
        android:background="@color/fg_dim"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/col_date" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_stats"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/content_margin"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="@dimen/content_margin"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/btn_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider" />

    <TextView
        android:id="@+id/text_empty"
        style="@style/MM.Text.Dim"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/stats_empty"
        app:layout_constraintBottom_toBottomOf="@id/rv_stats"
        app:layout_constraintEnd_toEndOf="@id/rv_stats"
        app:layout_constraintStart_toStartOf="@id/rv_stats"
        app:layout_constraintTop_toTopOf="@id/rv_stats" />

    <Button
        android:id="@+id/btn_back"
        style="@style/MM.Item"
        android:layout_marginStart="@dimen/content_margin"
        android:layout_marginBottom="32dp"
        android:text="@string/action_back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
