<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="MM" />

    <style name="MM.Screen">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@drawable/bg_screen</item>
        <item name="android:padding">@dimen/frame_inset</item>
        <item name="android:clipToPadding">false</item>
    </style>

    <style name="MM.Text">
        <item name="android:fontFamily">@font/app_font</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:textSize">14sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingStart">@dimen/item_padding</item>
        <item name="android:paddingEnd">@dimen/item_padding</item>
    </style>

    <style name="MM.Text.Title">
        <item name="android:textSize">44sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>

    <style name="MM.Text.Value">
        <item name="android:textSize">40sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="MM.Text.Dim">
        <item name="android:textColor">@color/fg_dim</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>

    <style name="MM.Text.BorderLabel">
        <item name="android:background">@color/bg</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Заголовок-«плашка»: инвертированный блок, как выделенное слово в текстовом квесте -->
    <style name="MM.Text.Title.Inverse">
        <item name="android:background">@color/fg</item>
        <item name="android:textColor">@color/bg</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="MM.Item" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_item</item>
        <item name="backgroundTint">@null</item>
        <item name="rippleColor">@android:color/transparent</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textColor">@color/text_item</item>
        <item name="android:fontFamily">@font/app_font</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">@dimen/item_padding</item>
        <item name="android:paddingEnd">@dimen/item_padding</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
    </style>

    <style name="MM.Item.Primary">
        <item name="android:background">@drawable/bg_item_primary</item>
        <item name="android:textColor">@color/text_item_primary</item>
    </style>

    <style name="MM.Item.Small">
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">40dp</item>
    </style>

    <style name="MM.Item.Icon">
        <item name="android:background">@drawable/bg_item_inverse</item>
        <item name="android:textColor">@color/text_item_inverse</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">52dp</item>
        <item name="android:minHeight">44dp</item>
    </style>
</resources>
